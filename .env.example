# Supabase — public, safe to expose to the browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only. NEVER prefix with NEXT_PUBLIC_. Never commit the
# real value. Used only in trusted server-side code (e.g. admin scripts),
# not in normal application Server Actions/Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=
